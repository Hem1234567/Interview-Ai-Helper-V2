# Auto-detect text files and handle line endings properly
* text=auto

# Shell scripts must use LF on disk so they execute on Linux CI
*.sh text eol=lf
*.py text eol=lf

# Gradle wrapper shell script
gradlew text eol=lf

# Windows batch files use CRLF
*.bat text eol=crlf
gradlew.bat text eol=crlf

# Kotlin / Java / XML / JSON / YAML / Markdown — normalize to LF
*.kt  text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.properties text eol=lf

# Binaries — no line-ending conversion
*.png binary
*.jpg binary
*.ico binary
*.apk binary
*.so  binary
*.gguf binary
*.bin binary
